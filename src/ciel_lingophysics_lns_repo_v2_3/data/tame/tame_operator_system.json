            "Perfekt"
          ],
          "fr": [
            "passé composé",
            "imparfait"
          ],
          "es": [
            "pretérito",
            "imperfecto"
          ]
        }
      },
      "Present": {
        "phase": 0.0,
        "meaning": "event simultaneous with reference time",
        "operators": {
          "pl": [
            "czas teraźniejszy"
          ],
          "en": [
            "present"
          ],
          "de": [
            "Präsens"
          ],
          "fr": [
            "présent"
          ],
          "es": [
            "presente"
          ]
        }
      },
      "Future": {
        "phase": 0.35,
        "meaning": "event after reference time",
        "operators": {
          "pl": [
            "będzie",
            "zrobi"
          ],
          "en": [
            "will",
            "going to"
          ],
          "de": [
            "werden"
          ],
          "fr": [
