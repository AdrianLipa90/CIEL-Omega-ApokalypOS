  "dimensions": {
    "tense": {
      "Past": {
        "phase": -0.35,
        "meaning": "event prior to reference time",
        "operators": {
          "pl": [
            "-ł/-ła/-ło",
            "był"
          ],
          "en": [
            "past tense",
            "did"
          ],
          "de": [
