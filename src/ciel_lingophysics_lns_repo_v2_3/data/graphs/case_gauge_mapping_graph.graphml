<edge id="e3" source="case:Nom" target="strategy:fr:Nom"><data key="type">maps_to_surface_strategy</data></edge>
<edge id="e4" source="case:Nom" target="strategy:es:Nom"><data key="type">maps_to_surface_strategy</data></edge>
