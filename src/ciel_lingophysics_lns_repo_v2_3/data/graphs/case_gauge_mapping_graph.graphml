<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
<graph edgedefault="directed">
<node id="case:Nom"><data key="label">Nom / mianownik</data><data key="type">CASE_ROLE</data></node>
<node id="op:SubjectOrIdentity"><data key="label">SubjectOrIdentity(x)</data><data key="type">CASE_OPERATOR</data></node>
<node id="strategy:en:Nom"><data key="label">subject position before finite verb; nominative pronouns he/she/they/I/we</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:de:Nom"><data key="label">nominative articles/pronouns plus subject agreement; flexible order with case marking</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:fr:Nom"><data key="label">subject position and clitic/tonic subject pronouns</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:es:Nom"><data key="label">subject agreement on verb, optional explicit subject, word order/pragmatics</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="case:Acc"><data key="label">Acc / biernik</data><data key="type">CASE_ROLE</data></node>
<node id="op:DirectPatient"><data key="label">DirectPatient(x)</data><data key="type">CASE_OPERATOR</data></node>
<node id="strategy:en:Acc"><data key="label">direct object position after transitive verb; object pronouns him/her/them/me/us</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:de:Acc"><data key="label">accusative articles/pronouns; direct object role</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:fr:Acc"><data key="label">direct object NP after verb or object clitic position before finite verb</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:es:Acc"><data key="label">direct object NP, personal a for human/animate specific objects, clitics</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="case:Gen"><data key="label">Gen / dopełniacz</data><data key="type">CASE_ROLE</data></node>
<node id="op:OfPossessionSourcePartitive"><data key="label">OfPossessionSourcePartitive(x,y)</data><data key="type">CASE_OPERATOR</data></node>
<node id="strategy:en:Gen"><data key="label">of-phrase, possessive 's, from, some/any/no, partitive expressions; sometimes word order</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:de:Gen"><data key="label">genitive for possession/formal register; von + dative in colloquial; governed prepositions</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:fr:Gen"><data key="label">de phrase for possession/source/partitive; articles du/de la/des; negation often de</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:es:Gen"><data key="label">de phrase for possession/source/partitive; partitive/negative expressed lexically</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="case:Dat"><data key="label">Dat / celownik</data><data key="type">CASE_ROLE</data></node>
<node id="op:RecipientBeneficiaryTarget"><data key="label">RecipientBeneficiaryTarget(x)</data><data key="type">CASE_OPERATOR</data></node>
<node id="strategy:en:Dat"><data key="label">to/for phrase or double-object construction</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:de:Dat"><data key="label">dative articles/pronouns; indirect object; governed prepositions</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:fr:Dat"><data key="label">à phrase or indirect object clitics lui/leur</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:es:Dat"><data key="label">a/para phrase or indirect object clitics le/les</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="case:Ins"><data key="label">Ins / narzędnik</data><data key="type">CASE_ROLE</data></node>
<node id="op:InstrumentMeansComitativeRole"><data key="label">InstrumentMeansComitativeRole(x)</data><data key="type">CASE_OPERATOR</data></node>
<node id="strategy:en:Ins"><data key="label">with/by/using/as phrases depending on role</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:de:Ins"><data key="label">mit/durch/von/als phrases, often dative after prepositions</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:fr:Ins"><data key="label">avec/par/en/comme phrases depending on role</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:es:Ins"><data key="label">con/por/usando/como phrases depending on role</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="case:Loc"><data key="label">Loc / miejscownik</data><data key="type">CASE_ROLE</data></node>
<node id="op:LocationTopicFrame"><data key="label">LocationTopicFrame(x)</data><data key="type">CASE_OPERATOR</data></node>
<node id="strategy:en:Loc"><data key="label">in/on/at/about/after/near phrases selected by lexical operator</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:de:Loc"><data key="label">in/an/auf/über/bei plus dative or accusative depending on static/directional role</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:fr:Loc"><data key="label">dans/sur/à/de/au sujet de phrases</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:es:Loc"><data key="label">en/sobre/a/cerca de phrases</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="case:Voc"><data key="label">Voc / wołacz</data><data key="type">CASE_ROLE</data></node>
<node id="op:Address"><data key="label">Address(x)</data><data key="type">CASE_OPERATOR</data></node>
<node id="strategy:en:Voc"><data key="label">bare name/noun with comma, intonation, O/hey in marked registers</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:de:Voc"><data key="label">bare name/noun with comma/intonation; no productive vocative morphology</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:fr:Voc"><data key="label">name/noun with comma/intonation; ô in literary register</data><data key="type">SURFACE_STRATEGY</data></node>
<node id="strategy:es:Voc"><data key="label">name/noun with comma/intonation; oye/oh in marked contexts</data><data key="type">SURFACE_STRATEGY</data></node>
<edge id="e0" source="case:Nom" target="op:SubjectOrIdentity"><data key="type">realizes_operator</data></edge>
<edge id="e1" source="case:Nom" target="strategy:en:Nom"><data key="type">maps_to_surface_strategy</data></edge>
